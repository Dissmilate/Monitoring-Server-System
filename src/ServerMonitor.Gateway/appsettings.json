{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://*:5090",
        "Protocols": "Http2"
      },
      "Http": {
        "Url": "http://*:5091",
        "Protocols": "Http1"
      }
    }
  }
}
