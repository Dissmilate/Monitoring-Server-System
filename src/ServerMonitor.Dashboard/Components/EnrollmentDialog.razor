@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Connect the agent of “@ServerName”</MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Dense Class="mb-4">
            The token is shown only now and works once, until @Format.LocalTime(Token.ExpiresAt).
            Issuing a new token invalidates this one.
        </MudAlert>

        <MudTextField Value="Token.Token" Label="Enrollment token" Variant="Variant.Outlined" ReadOnly Class="mono"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                      OnAdornmentClick="() => CopyAsync(Token.Token)" />

        <MudText Typo="Typo.subtitle2" Class="mt-6 mb-1">Agent container in the demo stack (docker compose)</MudText>
        <MudPaper Outlined Class="pa-3 mono d-flex align-center">
            <span class="flex-grow-1" style="word-break: break-all">@DockerCommand</span>
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="() => CopyAsync(DockerCommand)" />
        </MudPaper>

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Agent on another machine (Linux or Windows)</MudText>
        <MudPaper Outlined Class="pa-3 mono d-flex align-center">
            <span class="flex-grow-1" style="word-break: break-all">@DotnetCommand</span>
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="() => CopyAsync(DotnetCommand)" />
        </MudPaper>

        <MudText Typo="Typo.body2" Class="mt-4">
            The agent exchanges the token for its own API key and needs no token afterwards.
            This page turns <b>Online</b> as soon as it connects.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public EnrollmentTokenDto Token { get; set; } = default!;

    [Parameter, EditorRequired]
    public string ServerName { get; set; } = string.Empty;

    private string GatewayHost => new Uri(Navigation.BaseUri).Host;

    private string DockerCommand =>
        $"docker run -d --name {ContainerName} --hostname {ContainerName} --network server-monitor_default --user root " +
        $"-v server-monitor_demo-logs:/var/log/demo:ro -e Agent__Logs__Files__0=/var/log/demo/app.log " +
        $"-e Agent__GatewayUrl=http://gateway:5090 -e Agent__EnrollmentToken={Token.Token} server-monitor-agent-1";

    private string ContainerName
    {
        get
        {
            var slug = new string([.. ServerName.ToLowerInvariant().Select(c => char.IsAsciiLetterOrDigit(c) ? c : '-')]).Trim('-');
            return string.IsNullOrEmpty(slug) ? "monitor-agent" : slug;
        }
    }

    private string DotnetCommand =>
        $"dotnet run --project src/ServerMonitor.Agent -- --Agent:GatewayUrl=http://{GatewayHost}:5090 --Agent:EnrollmentToken={Token.Token}";

    private void Close() => Dialog.Close();

    private async Task CopyAsync(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        Snackbar.Add("Copied to the clipboard.", Severity.Info);
    }
}
